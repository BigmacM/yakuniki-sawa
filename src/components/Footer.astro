---
const currentYear = new Date().getFullYear();
---

<footer class="bg-ink border-t border-ember/20 pb-24 md:pb-0">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Brand -->
      <div class="lg:col-span-1">
        <div class="flex items-center gap-3 mb-4">
          <img
            src="/images/yakuniki-logo.png"
            alt="Yakiniku SAWA logo"
            class="h-10 w-auto object-contain opacity-90"
          />
          <div class="leading-tight">
            <div class="font-oswald text-xl font-bold tracking-widest text-washi uppercase">SAWA</div>
            <div class="font-open-sans text-[10px] tracking-[0.2em] text-ember uppercase">Yakiniku · Pattaya</div>
          </div>
        </div>
        <p class="text-washi/60 text-sm leading-relaxed">
          Premium Japanese Wagyu Yakiniku experience in the heart of Pattaya. Where the finest A5-rank beef meets ancient grilling tradition.
        </p>
        <div class="mt-4 flex items-center gap-2">
          <span class="text-ember text-xs font-oswald tracking-widest uppercase">No.1 Japanese Style Yakiniku</span>
        </div>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="font-oswald text-ember tracking-widest uppercase text-sm mb-5">Navigation</h3>
        <ul class="space-y-3">
          {[
            { href: '/', label: 'Home' },
            { href: '/menu', label: 'Our Menu' },
            { href: '/experience', label: 'The Experience' },
            { href: '/contact', label: 'Contact & Location' },
            { href: '/contact#reserve', label: 'Reserve a Table' },
          ].map(link => (
            <li>
              <a href={link.href} class="text-washi/60 hover:text-ember text-sm transition-colors duration-200">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="font-oswald text-ember tracking-widest uppercase text-sm mb-5">Contact</h3>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-ember mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="text-washi/60 leading-relaxed">502/54(b34) Tree Town,<br />Pattaya 9 Alley, Pattaya,<br />Chonburi 20150, Thailand</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-ember shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="tel:+6633640787" class="text-washi/60 hover:text-ember transition-colors duration-200">+66 33 640 787</a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-ember shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:contact@all-pattaya.com" class="text-washi/60 hover:text-ember transition-colors duration-200">contact@all-pattaya.com</a>
          </li>
        </ul>
      </div>

      <!-- Hours & Social -->
      <div>
        <h3 class="font-oswald text-ember tracking-widest uppercase text-sm mb-5">Opening Hours</h3>
        <div class="space-y-2 text-sm text-washi/60 mb-6">
          <div class="flex justify-between">
            <span>Mon – Sun</span>
            <span class="text-washi">17:00 – 23:00</span>
          </div>
          <p class="text-ember/70 text-xs mt-2">Last order at 22:00</p>
        </div>

        <h3 class="font-oswald text-ember tracking-widest uppercase text-sm mb-4">Connect</h3>
        <div class="flex gap-3">
          <a
            href="https://wa.me/6633640787"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 border border-ember/30 flex items-center justify-center text-washi/60 hover:text-ember hover:border-ember transition-all duration-200"
            aria-label="WhatsApp"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
          <a
            href="https://line.me/ti/p/~contact@all-pattaya.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 border border-ember/30 flex items-center justify-center text-washi/60 hover:text-ember hover:border-ember transition-all duration-200"
            aria-label="LINE"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
            </svg>
          </a>
          <a
            href="tel:+6633640787"
            class="w-9 h-9 border border-ember/30 flex items-center justify-center text-washi/60 hover:text-ember hover:border-ember transition-all duration-200"
            aria-label="Call us"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-8 border-t border-ember/10 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-washi/40 text-xs">
        &copy; {currentYear} Yakiniku SAWA Pattaya. All rights reserved.
      </p>
      <p class="text-washi/40 text-xs">
        502/54(b34) Tree Town, Pattaya 9 Alley, Chonburi, Thailand
      </p>
    </div>
  </div>
</footer>
