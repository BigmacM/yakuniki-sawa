---
import Layout from '../layouts/Layout.astro';
import { menuCategories } from '../data/menu';

const breadcrumbs = [{ name: 'Menu', url: '/menu' }];

const menuSchema = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: 'SAWA Yakiniku Menu',
  description: 'Full menu for Yakiniku SAWA Pattaya — Premium Wagyu, Seafood, Pork, Beverages and more.',
  url: 'https://yakiniku-sawa-pattaya.com/menu',
  hasMenuSection: menuCategories.map(cat => ({
    '@type': 'MenuSection',
    name: cat.title,
    hasMenuItem: cat.items.map(item => ({
      '@type': 'MenuItem',
      name: item.name,
      description: item.description ?? '',
      offers: {
        '@type': 'Offer',
        price: typeof item.price === 'number' ? item.price.toString() : item.price,
        priceCurrency: 'THB',
      },
    })),
  })),
};

// Helper: encode each path segment so spaces/parens in filenames work in URLs
function img(folder: string, filename: string): string {
  return `/images/${folder}/${encodeURIComponent(filename)}`;
}

// Actual menu gallery images — ordered from mains to drinks
const menuImages = [
  { src: img('menu-gallery', 'Premium Wagyu (2).jpg'),             label: 'Premium Wagyu',    alt: 'SAWA Premium Wagyu menu page' },
  { src: img('menu-gallery', 'Beef Wagyu Internal Organs (1).jpg'), label: 'Wagyu Specials',   alt: 'SAWA Wagyu specials menu page' },
  { src: img('menu-gallery', 'Fresh Pork (1).jpg'),                label: 'Fresh Pork',       alt: 'SAWA Fresh Pork menu page' },
  { src: img('menu-gallery', 'Sashimi and Salad (1).jpg'),         label: 'Sashimi & Salad',  alt: 'SAWA Sashimi and Salad menu page' },
  { src: img('menu-gallery', 'Appetizers (1).jpg'),                label: 'Appetizers',       alt: 'SAWA Appetizers menu page' },
  { src: img('menu-gallery', 'Rice and Soup (1).jpg'),             label: 'Rice & Soup',      alt: 'SAWA Rice and Soup menu page' },
  { src: img('menu-gallery', 'Sake (1).jpg'),                      label: 'Sake',             alt: 'SAWA Sake menu page' },
  { src: img('menu-gallery', 'Beer (1).jpg'),                      label: 'Beer',             alt: 'SAWA Beer menu page' },
  { src: img('menu-gallery', 'Whisky (1).jpg'),                    label: 'Whisky',           alt: 'SAWA Whisky menu page' },
  { src: img('menu-gallery', 'Sochu (1).jpg'),                     label: 'Shōchū',           alt: 'SAWA Shochu menu page' },
  { src: img('menu-gallery', 'Soft Drinks (1).jpg'),               label: 'Soft Drinks',      alt: 'SAWA Soft Drinks menu page' },
];
---

<Layout
  title="Menu | Yakiniku SAWA Pattaya — Wagyu BBQ & Sake Selection"
  description="Explore the full menu at Yakiniku SAWA Pattaya. Premium A5-rank Wagyu cuts, seafood, authentic Japanese appetizers, and a curated sake & spirits selection. Prices in Thai Baht."
  breadcrumbs={breadcrumbs}
  schema={menuSchema}
  page="menu"
>
  <!-- Page Hero -->
  <section class="relative py-24 md:py-32 bg-ink overflow-hidden" aria-label="Menu hero">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(212,175,55,0.08)_0%,transparent_60%)]" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-xs font-open-sans text-washi/40">
          <li><a href="/" class="hover:text-ember transition-colors">Home</a></li>
          <li aria-hidden="true"><span>/</span></li>
          <li class="text-ember" aria-current="page">Menu</li>
        </ol>
      </nav>
      <div class="flex items-center gap-3 mb-6">
        <div class="h-px w-8 bg-ember"></div>
        <span class="font-open-sans text-ember text-xs tracking-[0.3em] uppercase">Crafted with Precision</span>
      </div>
      <h1 class="section-heading text-5xl md:text-7xl text-washi mb-4">
        Our <span class="text-ember">Menu</span>
      </h1>
      <div class="ember-divider ml-0"></div>
      <p class="text-washi/60 text-lg max-w-2xl leading-relaxed">
        Every item on our menu is curated to deliver the authentic Yakiniku experience — from premium A5 Wagyu to artisanal sake pairings.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       INTERACTIVE MENU TABS
  ══════════════════════════════════════════════════ -->
  <section class="py-16 px-4 sm:px-6 bg-charcoal" aria-labelledby="interactive-menu-heading">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <h2 id="interactive-menu-heading" class="section-heading text-3xl md:text-4xl text-washi">
          Interactive <span class="text-ember">Menu</span>
        </h2>
        <div class="ember-divider"></div>
      </div>

      <!-- Category Tabs -->
      <div class="relative mb-8">
        <div
          id="menu-tabs"
          class="flex overflow-x-auto gap-1 pb-px scrollbar-thin"
          role="tablist"
          aria-label="Menu categories"
        >
          {menuCategories.map((cat, index) => (
            <button
              type="button"
              role="tab"
              id={`tab-${cat.id}`}
              aria-controls={`panel-${cat.id}`}
              aria-selected={index === 0}
              data-category={cat.id}
              class:list={[
                'menu-tab shrink-0 px-5 py-3 font-oswald text-sm tracking-widest uppercase border-b-2 transition-all duration-200 whitespace-nowrap',
                index === 0
                  ? 'border-ember text-ember'
                  : 'border-transparent text-washi/60 hover:text-washi hover:border-washi/30',
              ]}
            >
              <span class="mr-1.5" aria-hidden="true">{cat.icon}</span>
              {cat.title}
            </button>
          ))}
        </div>
        <div class="absolute bottom-0 left-0 right-0 h-px bg-ember/20"></div>
      </div>

      <!-- Menu Panels -->
      {menuCategories.map((cat, catIndex) => (
        <div
          id={`panel-${cat.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${cat.id}`}
          class:list={['menu-panel', catIndex !== 0 && 'hidden']}
        >
          {cat.subtitle && (
            <p class="text-washi/50 text-sm font-open-sans tracking-wide mb-6 text-center italic">
              {cat.subtitle}
            </p>
          )}
          <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
            {cat.items.map(item => (
              <div
                class:list={[
                  'card-ink p-5 flex items-start justify-between gap-4 group transition-all duration-300',
                  item.highlight && 'border-ember/40 bg-ember/5',
                ]}
              >
                <div class="flex-1 min-w-0">
                  {item.highlight && (
                    <span class="inline-block bg-ember text-charcoal text-[9px] font-oswald font-bold tracking-widest uppercase px-2 py-0.5 mb-2">
                      Featured
                    </span>
                  )}
                  <h3 class="font-oswald text-washi text-base font-semibold group-hover:text-ember transition-colors duration-200 leading-snug">
                    {item.name}
                  </h3>
                  {item.nameJp && (
                    <p class="text-ember/60 text-xs tracking-widest uppercase mt-0.5">{item.nameJp}</p>
                  )}
                  {item.nameTh && (
                    <p class="text-ember/60 text-xs tracking-widest uppercase mt-0.5">{item.nameTh}</p>
                  )}
                  {item.description && (
                    <p class="text-washi/50 text-xs leading-relaxed mt-1.5">{item.description}</p>
                  )}
                </div>
                <div class="shrink-0 text-right">
                  <span class="price-tag text-base whitespace-nowrap">
                    {typeof item.price === 'number' ? `${item.price.toLocaleString()}฿` : item.price}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       DIGITAL MENU BOOK
  ══════════════════════════════════════════════════ -->
  <section class="py-24 px-4 sm:px-6 bg-ink" aria-labelledby="menu-book-heading">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <div class="flex items-center justify-center gap-3 mb-6">
          <div class="h-px w-8 bg-ember"></div>
          <span class="font-open-sans text-ember text-xs tracking-[0.3em] uppercase">Visual Menu</span>
          <div class="h-px w-8 bg-ember"></div>
        </div>
        <h2 id="menu-book-heading" class="section-heading text-3xl md:text-4xl text-washi">
          Digital <span class="text-ember">Menu Book</span>
        </h2>
        <div class="ember-divider"></div>
        <p class="text-washi/60 max-w-xl mx-auto text-sm">
          Browse our actual menu pages. Click any image to view in full detail.
        </p>
      </div>

      <!-- Menu Gallery Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
        {menuImages.map((img, index) => (
          <button
            type="button"
            class="menu-gallery-btn relative aspect-[3/4] bg-charcoal card-ink overflow-hidden group focus:outline-none focus:ring-2 focus:ring-ember focus:ring-offset-2 focus:ring-offset-ink"
            data-index={index}
            aria-label={`View ${img.label} menu page`}
          >
            <img
              src={img.src}
              alt={img.alt}
              class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal/80 via-transparent to-transparent flex items-end justify-center pb-4 pointer-events-none">
              <span class="font-oswald text-ember text-xs tracking-widest uppercase">{img.label}</span>
            </div>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       LIGHTBOX — controlled purely via JS style.display
       z-[100] ensures it sits above MobileFooter (z-50)
  ══════════════════════════════════════════════════ -->
  <div
    id="lightbox"
    role="dialog"
    aria-modal="true"
    aria-label="Menu image viewer"
    tabindex="-1"
    style="display:none; position:fixed; inset:0; z-index:100; background:rgba(0,0,0,0.96);"
  >
    <!-- Top bar: caption + close -->
    <div class="absolute top-0 left-0 right-0 flex items-center justify-between px-4 py-3 z-10 bg-charcoal/60">
      <span id="lightbox-caption" class="font-oswald text-ember text-sm tracking-widest uppercase"></span>
      <button
        type="button"
        id="lightbox-close"
        class="text-washi/80 hover:text-ember transition-colors duration-200 p-2 ml-4"
        aria-label="Close image viewer"
      >
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Image area — padded so it doesn't overlap buttons -->
    <div class="absolute inset-0 flex items-center justify-center px-16 py-16">
      <img
        id="lightbox-img"
        src=""
        alt=""
        class="max-w-full max-h-full object-contain select-none"
      />
    </div>

    <!-- Prev button -->
    <button
      type="button"
      id="lightbox-prev"
      class="absolute left-2 top-1/2 -translate-y-1/2 z-10 bg-charcoal/70 hover:bg-ember/20 border border-ember/30 hover:border-ember text-washi/80 hover:text-ember transition-all duration-200 p-3"
      aria-label="Previous image"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <!-- Next button -->
    <button
      type="button"
      id="lightbox-next"
      class="absolute right-2 top-1/2 -translate-y-1/2 z-10 bg-charcoal/70 hover:bg-ember/20 border border-ember/30 hover:border-ember text-washi/80 hover:text-ember transition-all duration-200 p-3"
      aria-label="Next image"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <!-- Tap backdrop to close (behind the image div) -->
    <div id="lightbox-backdrop-tap" class="absolute inset-0" aria-hidden="true"></div>
  </div>

  <!-- ═══════════════════════════════════════════════
       BOOKING CTA
  ══════════════════════════════════════════════════ -->
  <section class="py-16 px-4 sm:px-6 bg-charcoal text-center" aria-labelledby="menu-cta-heading">
    <div class="max-w-2xl mx-auto">
      <h2 id="menu-cta-heading" class="section-heading text-3xl md:text-4xl text-washi mb-4">
        Ready to <span class="text-ember">Indulge?</span>
      </h2>
      <p class="text-washi/60 mb-8 leading-relaxed">
        Reserve your table now and experience the finest Wagyu Yakiniku in Pattaya.
      </p>
      <a href="/contact#reserve" class="btn-sake">Book Your Table</a>
    </div>
  </section>
</Layout>

<script>
  // ─── Menu Tab System ───────────────────────────────────────
  const tabs = document.querySelectorAll<HTMLButtonElement>('[role="tab"]');
  const panels = document.querySelectorAll<HTMLElement>('[role="tabpanel"]');

  function activateTab(targetId: string) {
    tabs.forEach(tab => {
      const isActive = tab.dataset.category === targetId;
      tab.setAttribute('aria-selected', String(isActive));
      tab.classList.toggle('border-ember', isActive);
      tab.classList.toggle('text-ember', isActive);
      tab.classList.toggle('border-transparent', !isActive);
      tab.classList.toggle('text-washi/60', !isActive);
    });
    panels.forEach(panel => {
      panel.classList.toggle('hidden', panel.id !== `panel-${targetId}`);
    });
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const category = tab.dataset.category;
      if (category) activateTab(category);
      if (window.innerWidth < 768) {
        document.getElementById(`panel-${category}`)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    tab.addEventListener('keydown', (e: KeyboardEvent) => {
      const tabList = Array.from(tabs);
      const currentIndex = tabList.indexOf(tab);
      let nextIndex = currentIndex;
      if (e.key === 'ArrowRight') nextIndex = (currentIndex + 1) % tabList.length;
      if (e.key === 'ArrowLeft') nextIndex = (currentIndex - 1 + tabList.length) % tabList.length;
      if (nextIndex !== currentIndex) {
        tabList[nextIndex].focus();
        tabList[nextIndex].click();
      }
    });
  });

  // ─── Lightbox System ───────────────────────────────────────
  // Image data mirrored from the frontmatter (must match exactly)
  const galleryImages = [
    { src: '/images/menu-gallery/Premium%20Wagyu%20(2).jpg',             label: 'Premium Wagyu — Page 1 of 11' },
    { src: '/images/menu-gallery/Beef%20Wagyu%20Internal%20Organs%20(1).jpg', label: 'Wagyu Specials — Page 2 of 11' },
    { src: '/images/menu-gallery/Fresh%20Pork%20(1).jpg',                label: 'Fresh Pork — Page 3 of 11' },
    { src: '/images/menu-gallery/Sashimi%20and%20Salad%20(1).jpg',       label: 'Sashimi & Salad — Page 4 of 11' },
    { src: '/images/menu-gallery/Appetizers%20(1).jpg',                  label: 'Appetizers — Page 5 of 11' },
    { src: '/images/menu-gallery/Rice%20and%20Soup%20(1).jpg',           label: 'Rice & Soup — Page 6 of 11' },
    { src: '/images/menu-gallery/Sake%20(1).jpg',                        label: 'Sake — Page 7 of 11' },
    { src: '/images/menu-gallery/Beer%20(1).jpg',                        label: 'Beer — Page 8 of 11' },
    { src: '/images/menu-gallery/Whisky%20(1).jpg',                      label: 'Whisky — Page 9 of 11' },
    { src: '/images/menu-gallery/Sochu%20(1).jpg',                       label: 'Shōchū — Page 10 of 11' },
    { src: '/images/menu-gallery/Soft%20Drinks%20(1).jpg',               label: 'Soft Drinks — Page 11 of 11' },
  ];

  const lightbox       = document.getElementById('lightbox')!;
  const lightboxImg    = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxCaption = document.getElementById('lightbox-caption')!;
  const backdropTap    = document.getElementById('lightbox-backdrop-tap')!;
  let currentIdx = 0;

  function openLightbox(index: number) {
    currentIdx = index;
    const entry = galleryImages[index];
    lightboxImg.src = entry.src;
    lightboxImg.alt = entry.label;
    lightboxCaption.textContent = entry.label;
    lightbox.style.display = 'block';
    document.body.style.overflow = 'hidden';
    lightbox.focus();
  }

  function closeLightbox() {
    lightbox.style.display = 'none';
    document.body.style.overflow = '';
  }

  function navigate(dir: number) {
    currentIdx = (currentIdx + dir + galleryImages.length) % galleryImages.length;
    openLightbox(currentIdx);
  }

  // Gallery buttons
  document.querySelectorAll<HTMLButtonElement>('.menu-gallery-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      openLightbox(parseInt(btn.dataset.index ?? '0', 10));
    });
  });

  // Controls
  document.getElementById('lightbox-close')!.addEventListener('click', closeLightbox);
  document.getElementById('lightbox-prev')!.addEventListener('click', () => navigate(-1));
  document.getElementById('lightbox-next')!.addEventListener('click', () => navigate(1));
  backdropTap.addEventListener('click', closeLightbox);

  // Keyboard
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (lightbox.style.display === 'none') return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') navigate(-1);
    if (e.key === 'ArrowRight') navigate(1);
  });

  // Touch swipe support
  let touchStartX = 0;
  lightbox.addEventListener('touchstart', (e: TouchEvent) => {
    touchStartX = e.touches[0].clientX;
  }, { passive: true });
  lightbox.addEventListener('touchend', (e: TouchEvent) => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 50) navigate(dx < 0 ? 1 : -1);
  }, { passive: true });
</script>
