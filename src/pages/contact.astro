---
import Layout from '../layouts/Layout.astro';

const breadcrumbs = [{ name: 'Contact', url: '/contact' }];

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Yakiniku SAWA Pattaya',
  telephone: '+6633640787',
  email: 'contact@all-pattaya.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '502/54(b34) Tree Town, Pattaya 9 Alley',
    addressLocality: 'Pattaya',
    addressRegion: 'Chonburi',
    postalCode: '20150',
    addressCountry: 'TH',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 12.9236,
    longitude: 100.8825,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '17:00',
      closes: '23:00',
    },
  ],
  url: 'https://yakiniku-sawa-pattaya.com',
};
---

<Layout
  title="Contact & Location | Yakiniku SAWA Pattaya — Reserve Your Table"
  description="Find and contact Yakiniku SAWA Pattaya. Located at Tree Town, Pattaya. Call +66 33 640 787, WhatsApp, or LINE. Reserve your premium Wagyu Yakiniku experience today."
  breadcrumbs={breadcrumbs}
  schema={localBusinessSchema}
  page="contact"
>
  <!-- Page Hero -->
  <section class="relative py-24 md:py-32 bg-ink overflow-hidden" aria-label="Contact hero">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(212,175,55,0.07)_0%,transparent_60%)]" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-xs font-open-sans text-washi/40">
          <li><a href="/" class="hover:text-ember transition-colors">Home</a></li>
          <li aria-hidden="true"><span>/</span></li>
          <li class="text-ember" aria-current="page">Contact</li>
        </ol>
      </nav>
      <div class="flex items-center gap-3 mb-6">
        <div class="h-px w-8 bg-ember"></div>
        <span class="font-open-sans text-ember text-xs tracking-[0.3em] uppercase">Find Us</span>
      </div>
      <h1 class="section-heading text-5xl md:text-7xl text-washi mb-4 leading-none">
        Contact &<br /><span class="text-ember">Location</span>
      </h1>
      <div class="ember-divider ml-0"></div>
      <p class="text-washi/60 text-lg max-w-xl leading-relaxed">
        We'd love to welcome you at SAWA. Find us at Tree Town, Pattaya or reach out to reserve your table.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       CONTACT GRID
  ══════════════════════════════════════════════════ -->
  <section class="py-16 px-4 sm:px-6 bg-charcoal" aria-labelledby="contact-info-heading">
    <div class="max-w-7xl mx-auto">
      <h2 id="contact-info-heading" class="sr-only">Contact Information</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Address -->
        <div class="card-ink p-8 group hover:border-ember/60 transition-all duration-300">
          <div class="w-12 h-12 border border-ember/30 flex items-center justify-center mb-5 group-hover:bg-ember/10 transition-colors duration-300">
            <svg class="w-5 h-5 text-ember" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="font-oswald text-ember tracking-widest uppercase text-sm mb-3">Address</h3>
          <address class="not-italic text-washi/70 text-sm leading-relaxed">
            502/54(b34) Tree Town,<br />
            Pattaya 9 Alley,<br />
            Pattaya, Chonburi 20150,<br />
            Thailand
          </address>
          <a
            href="https://maps.google.com/?q=502/54+Tree+Town+Pattaya"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-ember text-xs tracking-wider uppercase font-oswald mt-4 hover:text-ember-dark transition-colors duration-200"
            aria-label="Get directions to SAWA Pattaya on Google Maps"
          >
            Get Directions
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

        <!-- Phone -->
        <div class="card-ink p-8 group hover:border-ember/60 transition-all duration-300">
          <div class="w-12 h-12 border border-ember/30 flex items-center justify-center mb-5 group-hover:bg-ember/10 transition-colors duration-300">
            <svg class="w-5 h-5 text-ember" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <h3 class="font-oswald text-ember tracking-widest uppercase text-sm mb-3">Phone</h3>
          <a href="tel:+6633640787" class="text-washi/70 text-sm hover:text-ember transition-colors duration-200 block mb-2">
            +66 33 640 787
          </a>
          <p class="text-washi/40 text-xs">Available during opening hours</p>
          <a href="tel:+6633640787" class="inline-flex items-center gap-1 text-ember text-xs tracking-wider uppercase font-oswald mt-4 hover:text-ember-dark transition-colors duration-200">
            Call Now
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

        <!-- Messaging -->
        <div class="card-ink p-8 group hover:border-ember/60 transition-all duration-300">
          <div class="w-12 h-12 border border-ember/30 flex items-center justify-center mb-5 group-hover:bg-ember/10 transition-colors duration-300">
            <svg class="w-5 h-5 text-ember" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
          </div>
          <h3 class="font-oswald text-ember tracking-widest uppercase text-sm mb-3">Messaging</h3>
          <div class="space-y-2 mb-4">
            <a
              href="https://wa.me/6633640787"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-washi/70 text-sm hover:text-ember transition-colors duration-200"
            >
              <span class="text-base" aria-hidden="true">💬</span>
              WhatsApp: +66 33 640 787
            </a>
            <a
              href="https://line.me/ti/p/~contact@all-pattaya.com"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-washi/70 text-sm hover:text-ember transition-colors duration-200"
            >
              <span class="text-base" aria-hidden="true">💚</span>
              LINE: @sawapattaya
            </a>
          </div>
          <a
            href="https://wa.me/6633640787?text=Hello%2C%20I%27d%20like%20to%20reserve%20a%20table%20at%20SAWA%20Pattaya."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-ember text-xs tracking-wider uppercase font-oswald hover:text-ember-dark transition-colors duration-200"
          >
            Message Us
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

        <!-- Hours -->
        <div class="card-ink p-8 group hover:border-ember/60 transition-all duration-300">
          <div class="w-12 h-12 border border-ember/30 flex items-center justify-center mb-5 group-hover:bg-ember/10 transition-colors duration-300">
            <svg class="w-5 h-5 text-ember" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-oswald text-ember tracking-widest uppercase text-sm mb-3">Opening Hours</h3>
          <div class="space-y-2 text-sm text-washi/70">
            <div class="flex justify-between">
              <span>Every Day</span>
              <span class="text-washi font-semibold">17:00 – 23:00</span>
            </div>
            <div class="flex justify-between text-xs">
              <span class="text-washi/50">Last Order</span>
              <span class="text-ember">22:00</span>
            </div>
          </div>
          <div class="mt-4 pt-4 border-t border-ember/10">
            <p class="text-washi/40 text-xs">Reservations recommended for weekends</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       RESERVATION FORM + MAP
  ══════════════════════════════════════════════════ -->
  <section id="reserve" class="py-24 px-4 sm:px-6 bg-ink scroll-mt-20" aria-labelledby="reserve-heading">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">

        <!-- Reservation Form -->
        <div>
          <div class="flex items-center gap-3 mb-6">
            <div class="h-px w-8 bg-ember"></div>
            <span class="font-open-sans text-ember text-xs tracking-[0.3em] uppercase">Reservations</span>
          </div>
          <h2 id="reserve-heading" class="section-heading text-4xl md:text-5xl text-washi mb-4 leading-tight">
            Reserve Your<br /><span class="text-ember">Table</span>
          </h2>
          <div class="ember-divider ml-0"></div>
          <p class="text-washi/60 mb-8 leading-relaxed text-sm">
            Fill in your details and we'll confirm your reservation via WhatsApp or phone. For same-day bookings, please call us directly.
          </p>

          <form
            id="reservation-form"
            class="space-y-5"
            action="https://wa.me/6633640787"
            method="get"
            target="_blank"
            novalidate
          >
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block font-oswald text-xs tracking-widest uppercase text-washi/70 mb-2">
                  Full Name <span class="text-sake-red" aria-hidden="true">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  autocomplete="name"
                  class="w-full bg-charcoal border border-ember/20 text-washi text-sm px-4 py-3 focus:outline-none focus:border-ember transition-colors duration-200 placeholder:text-washi/30"
                  placeholder="Your name"
                />
              </div>
              <div>
                <label for="phone" class="block font-oswald text-xs tracking-widest uppercase text-washi/70 mb-2">
                  Phone Number <span class="text-sake-red" aria-hidden="true">*</span>
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  autocomplete="tel"
                  class="w-full bg-charcoal border border-ember/20 text-washi text-sm px-4 py-3 focus:outline-none focus:border-ember transition-colors duration-200 placeholder:text-washi/30"
                  placeholder="+66 XX XXX XXXX"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="date" class="block font-oswald text-xs tracking-widest uppercase text-washi/70 mb-2">
                  Date <span class="text-sake-red" aria-hidden="true">*</span>
                </label>
                <input
                  type="date"
                  id="date"
                  name="date"
                  required
                  class="w-full bg-charcoal border border-ember/20 text-washi text-sm px-4 py-3 focus:outline-none focus:border-ember transition-colors duration-200 [color-scheme:dark]"
                />
              </div>
              <div>
                <label for="time" class="block font-oswald text-xs tracking-widest uppercase text-washi/70 mb-2">
                  Time <span class="text-sake-red" aria-hidden="true">*</span>
                </label>
                <select
                  id="time"
                  name="time"
                  required
                  class="w-full bg-charcoal border border-ember/20 text-washi text-sm px-4 py-3 focus:outline-none focus:border-ember transition-colors duration-200"
                >
                  <option value="" disabled selected>Select time</option>
                  {['17:00', '17:30', '18:00', '18:30', '19:00', '19:30', '20:00', '20:30', '21:00', '21:30', '22:00'].map(t => (
                    <option value={t}>{t}</option>
                  ))}
                </select>
              </div>
            </div>

            <div>
              <label for="guests" class="block font-oswald text-xs tracking-widest uppercase text-washi/70 mb-2">
                Number of Guests <span class="text-sake-red" aria-hidden="true">*</span>
              </label>
              <select
                id="guests"
                name="guests"
                required
                class="w-full bg-charcoal border border-ember/20 text-washi text-sm px-4 py-3 focus:outline-none focus:border-ember transition-colors duration-200"
              >
                <option value="" disabled selected>Select number of guests</option>
                {Array.from({ length: 10 }, (_, i) => i + 1).map(n => (
                  <option value={n}>{n} {n === 1 ? 'Guest' : 'Guests'}</option>
                ))}
                <option value="11+">11+ Guests (Group reservation)</option>
              </select>
            </div>

            <div>
              <label for="requests" class="block font-oswald text-xs tracking-widest uppercase text-washi/70 mb-2">
                Special Requests
              </label>
              <textarea
                id="requests"
                name="requests"
                rows={3}
                class="w-full bg-charcoal border border-ember/20 text-washi text-sm px-4 py-3 focus:outline-none focus:border-ember transition-colors duration-200 resize-none placeholder:text-washi/30"
                placeholder="Allergies, dietary requirements, celebrations..."
              ></textarea>
            </div>

            <div class="flex flex-col sm:flex-row gap-4 pt-2">
              <button type="submit" class="btn-sake flex-1 text-center" id="whatsapp-btn">
                Book via WhatsApp
              </button>
              <a href="tel:+6633640787" class="btn-outline flex-1 text-center">
                Call Directly
              </a>
            </div>

            <p class="text-washi/40 text-xs leading-relaxed">
              By submitting, you'll be redirected to WhatsApp with your reservation details pre-filled. Confirmation is subject to availability.
            </p>
          </form>
        </div>

        <!-- Map + Info -->
        <div class="space-y-6">
          <div>
            <div class="flex items-center gap-3 mb-6">
              <div class="h-px w-8 bg-ember"></div>
              <span class="font-open-sans text-ember text-xs tracking-[0.3em] uppercase">Find Us</span>
            </div>
            <h2 class="section-heading text-3xl text-washi mb-4">
              Tree Town,<br /><span class="text-ember">Pattaya</span>
            </h2>
          </div>

          <!-- Google Maps Embed -->
          <div class="relative aspect-video bg-charcoal card-ink overflow-hidden">
            <iframe
              title="Yakiniku SAWA Pattaya location map"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3906.9258!2d100.8825!3d12.9236!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTLCsDU1JzI1LjAiTiAxMDDCsDUyJzU3LjAiRQ!5e0!3m2!1sen!2sth!4v1699999999999!5m2!1sen!2sth"
              class="w-full h-full border-0 grayscale contrast-125 opacity-90"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
          </div>

          <!-- Getting There -->
          <div class="card-ink p-6 space-y-4">
            <h3 class="font-oswald text-ember tracking-widest uppercase text-sm">Getting There</h3>
            <div class="space-y-3 text-sm text-washi/70">
              <div class="flex items-start gap-3">
                <span class="text-ember mt-0.5 shrink-0">🚕</span>
                <div>
                  <strong class="text-washi block mb-0.5">By Taxi / Grab</strong>
                  Show the driver: ร้านยากินิกุซาวะ พัทยา หรือ Tree Town พัทยา ซอย 9
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-ember mt-0.5 shrink-0">🚗</span>
                <div>
                  <strong class="text-washi block mb-0.5">By Car</strong>
                  Located inside Tree Town shopping complex, Pattaya 9 Alley. Parking available.
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-ember mt-0.5 shrink-0">📍</span>
                <div>
                  <strong class="text-washi block mb-0.5">GPS Coordinates</strong>
                  12.9236° N, 100.8825° E
                </div>
              </div>
            </div>
            <a
              href="https://maps.google.com/?q=Tree+Town+Pattaya+Yakiniku+SAWA"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-ember w-full text-center block text-sm"
            >
              Open in Google Maps
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       EMAIL CONTACT
  ══════════════════════════════════════════════════ -->
  <section class="py-16 px-4 sm:px-6 bg-charcoal" aria-labelledby="email-heading">
    <div class="max-w-3xl mx-auto text-center">
      <h2 id="email-heading" class="section-heading text-3xl text-washi mb-4">
        Have a <span class="text-ember">Question?</span>
      </h2>
      <div class="ember-divider"></div>
      <p class="text-washi/60 mb-8 leading-relaxed">
        For corporate bookings, private events, or general enquiries, reach out to us via email and we'll respond within 24 hours.
      </p>
      <a
        href="mailto:contact@all-pattaya.com"
        class="btn-outline inline-flex items-center gap-2"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        contact@all-pattaya.com
      </a>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('reservation-form') as HTMLFormElement;

  form?.addEventListener('submit', (e: Event) => {
    e.preventDefault();

    const name = (document.getElementById('name') as HTMLInputElement).value.trim();
    const phone = (document.getElementById('phone') as HTMLInputElement).value.trim();
    const date = (document.getElementById('date') as HTMLInputElement).value;
    const time = (document.getElementById('time') as HTMLSelectElement).value;
    const guests = (document.getElementById('guests') as HTMLSelectElement).value;
    const requests = (document.getElementById('requests') as HTMLTextAreaElement).value.trim();

    if (!name || !phone || !date || !time || !guests) {
      alert('Please fill in all required fields.');
      return;
    }

    const message = [
      `Hello! I'd like to make a reservation at Yakiniku SAWA Pattaya.`,
      ``,
      `Name: ${name}`,
      `Phone: ${phone}`,
      `Date: ${date}`,
      `Time: ${time}`,
      `Guests: ${guests}`,
      requests ? `Special Requests: ${requests}` : '',
    ]
      .filter(Boolean)
      .join('\n');

    const encodedMsg = encodeURIComponent(message);
    window.open(`https://wa.me/6633640787?text=${encodedMsg}`, '_blank', 'noopener,noreferrer');
  });

  // Set minimum date to today
  const dateInput = document.getElementById('date') as HTMLInputElement;
  if (dateInput) {
    const today = new Date();
    const yyyy = today.getFullYear();
    const mm = String(today.getMonth() + 1).padStart(2, '0');
    const dd = String(today.getDate()).padStart(2, '0');
    dateInput.min = `${yyyy}-${mm}-${dd}`;
  }
</script>
