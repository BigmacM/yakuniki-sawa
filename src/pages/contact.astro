---
import Layout from '../layouts/Layout.astro';

const breadcrumbs = [{ name: 'Contact', url: '/contact' }];

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Yakiniku SAWA Pattaya',
  telephone: '+6633640787',
  email: 'contact@all-pattaya.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '502/54(b34) Tree Town, Pattaya 9 Alley',
    addressLocality: 'Pattaya',
    addressRegion: 'Chonburi',
    postalCode: '20150',
    addressCountry: 'TH',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 12.9236,
    longitude: 100.8825,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '17:00',
      closes: '23:00',
    },
  ],
  url: 'https://yakiniku-sawa-pattaya.com',
};
---

<Layout
  title="Contact & Location | Yakiniku SAWA Pattaya — Reserve Your Table"
  description="Find and contact Yakiniku SAWA Pattaya. Located at Tree Town, Pattaya. Call +66 33 640 787, WhatsApp, or LINE. Reserve your premium Wagyu Yakiniku experience today."
  breadcrumbs={breadcrumbs}
  schema={localBusinessSchema}
  page="contact"
>
  <!-- Page Hero -->
  <section class="relative py-24 md:py-32 bg-ink overflow-hidden" aria-label="Contact hero">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(212,175,55,0.07)_0%,transparent_60%)]" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-xs font-open-sans text-washi/40">
          <li><a href="/" class="hover:text-ember transition-colors">Home</a></li>
          <li aria-hidden="true"><span>/</span></li>
          <li class="text-ember" aria-current="page">Contact</li>
        </ol>
      </nav>
      <div class="flex items-center gap-3 mb-6">
        <div class="h-px w-8 bg-ember"></div>
        <span class="font-open-sans text-ember text-xs tracking-[0.3em] uppercase">Find Us</span>
      </div>
      <h1 class="section-heading text-5xl md:text-7xl text-washi mb-4 leading-none">
        Contact &<br /><span class="text-ember">Location</span>
      </h1>
      <div class="ember-divider ml-0"></div>
      <p class="text-washi/60 text-lg max-w-xl leading-relaxed">
        We'd love to welcome you at SAWA. Find us at Tree Town, Pattaya or reach out to reserve your table.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       CONTACT GRID
  ══════════════════════════════════════════════════ -->
  <section class="py-16 px-4 sm:px-6 bg-charcoal" aria-labelledby="contact-info-heading">
    <div class="max-w-7xl mx-auto">
      <h2 id="contact-info-heading" class="sr-only">Contact Information</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Address -->
        <div class="card-ink p-8 group hover:border-ember/60 transition-all duration-300">
          <div class="w-12 h-12 border border-ember/30 flex items-center justify-center mb-5 group-hover:bg-ember/10 transition-colors duration-300">
            <svg class="w-5 h-5 text-ember" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="font-oswald text-ember tracking-widest uppercase text-sm mb-3">Address</h3>
          <address class="not-italic text-washi/70 text-sm leading-relaxed">
            502/54(b34) Tree Town,<br />
            Pattaya 9 Alley,<br />
            Pattaya, Chonburi 20150,<br />
            Thailand
          </address>
          <a
            href="https://maps.google.com/?q=502/54+Tree+Town+Pattaya"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-ember text-xs tracking-wider uppercase font-oswald mt-4 hover:text-ember-dark transition-colors duration-200"
            aria-label="Get directions to SAWA Pattaya on Google Maps"
          >
            Get Directions
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

        <!-- Phone -->
        <div class="card-ink p-8 group hover:border-ember/60 transition-all duration-300">
          <div class="w-12 h-12 border border-ember/30 flex items-center justify-center mb-5 group-hover:bg-ember/10 transition-colors duration-300">
            <svg class="w-5 h-5 text-ember" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <h3 class="font-oswald text-ember tracking-widest uppercase text-sm mb-3">Phone</h3>
          <a href="tel:+6633640787" class="text-washi/70 text-sm hover:text-ember transition-colors duration-200 block mb-2">
            +66 33 640 787
          </a>
          <p class="text-washi/40 text-xs">Available during opening hours</p>
          <a href="tel:+6633640787" class="inline-flex items-center gap-1 text-ember text-xs tracking-wider uppercase font-oswald mt-4 hover:text-ember-dark transition-colors duration-200">
            Call Now
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

        <!-- Messaging -->
        <div class="card-ink p-8 group hover:border-ember/60 transition-all duration-300">
          <div class="w-12 h-12 border border-ember/30 flex items-center justify-center mb-5 group-hover:bg-ember/10 transition-colors duration-300">
            <svg class="w-5 h-5 text-ember" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
          </div>
          <h3 class="font-oswald text-ember tracking-widest uppercase text-sm mb-3">Messaging</h3>
          <div class="space-y-2 mb-4">
            <a
              href="https://wa.me/6633640787"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-washi/70 text-sm hover:text-ember transition-colors duration-200"
            >
              <span class="text-base" aria-hidden="true">💬</span>
              WhatsApp: +66 33 640 787
            </a>
            <a
              href="https://line.me/ti/p/~contact@all-pattaya.com"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-washi/70 text-sm hover:text-ember transition-colors duration-200"
            >
              <span class="text-base" aria-hidden="true">💚</span>
              LINE: @sawapattaya
            </a>
          </div>
          <a
            href="https://wa.me/6633640787?text=Hello%2C%20I%27d%20like%20to%20reserve%20a%20table%20at%20SAWA%20Pattaya."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-ember text-xs tracking-wider uppercase font-oswald hover:text-ember-dark transition-colors duration-200"
          >
            Message Us
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

        <!-- Hours -->
        <div class="card-ink p-8 group hover:border-ember/60 transition-all duration-300">
          <div class="w-12 h-12 border border-ember/30 flex items-center justify-center mb-5 group-hover:bg-ember/10 transition-colors duration-300">
            <svg class="w-5 h-5 text-ember" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-oswald text-ember tracking-widest uppercase text-sm mb-3">Opening Hours</h3>
          <div class="space-y-2 text-sm text-washi/70">
            <div class="flex justify-between">
              <span>Every Day</span>
              <span class="text-washi font-semibold">17:00 – 23:00</span>
            </div>
            <div class="flex justify-between text-xs">
              <span class="text-washi/50">Last Order</span>
              <span class="text-ember">22:00</span>
            </div>
          </div>
          <div class="mt-4 pt-4 border-t border-ember/10">
            <p class="text-washi/40 text-xs">Reservations recommended for weekends</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       RESERVE — direct contact CTAs
  ══════════════════════════════════════════════════ -->
  <section id="reserve" class="py-24 px-4 sm:px-6 bg-ink scroll-mt-20" aria-labelledby="reserve-heading">
    <div class="max-w-7xl mx-auto">

      <div class="text-center mb-12">
        <div class="flex items-center justify-center gap-3 mb-6">
          <div class="h-px w-8 bg-ember"></div>
          <span class="font-open-sans text-ember text-xs tracking-[0.3em] uppercase">Reservations</span>
          <div class="h-px w-8 bg-ember"></div>
        </div>
        <h2 id="reserve-heading" class="section-heading text-4xl md:text-5xl text-washi mb-4 leading-tight">
          Reserve Your <span class="text-ember">Table</span>
        </h2>
        <div class="ember-divider"></div>
        <p class="text-washi/60 max-w-lg mx-auto leading-relaxed">
          Contact us directly via phone, WhatsApp, or LINE to secure your evening. We're available during opening hours daily.
        </p>
      </div>

      <!-- Direct contact CTAs -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-3xl mx-auto mb-16">
        <a
          href="tel:+6633640787"
          class="card-ink p-6 flex flex-col items-center gap-3 text-center group hover:border-ember/60 transition-all duration-300"
        >
          <div class="w-12 h-12 border border-ember/30 flex items-center justify-center group-hover:bg-ember/10 transition-colors duration-300">
            <svg class="w-5 h-5 text-ember" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <div>
            <div class="font-oswald text-ember tracking-widest uppercase text-sm mb-1">Call Us</div>
            <div class="text-washi text-sm font-open-sans">+66 33 640 787</div>
          </div>
        </a>

        <a
          href="https://wa.me/6633640787?text=Hello%2C%20I%27d%20like%20to%20reserve%20a%20table%20at%20SAWA%20Pattaya."
          target="_blank"
          rel="noopener noreferrer"
          class="card-ink p-6 flex flex-col items-center gap-3 text-center group hover:border-ember/60 transition-all duration-300"
        >
          <div class="w-12 h-12 border border-ember/30 flex items-center justify-center group-hover:bg-ember/10 transition-colors duration-300">
            <svg class="w-5 h-5 text-ember" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </div>
          <div>
            <div class="font-oswald text-ember tracking-widest uppercase text-sm mb-1">WhatsApp</div>
            <div class="text-washi text-sm font-open-sans">+66 33 640 787</div>
          </div>
        </a>

        <a
          href="https://line.me/ti/p/~contact@all-pattaya.com"
          target="_blank"
          rel="noopener noreferrer"
          class="card-ink p-6 flex flex-col items-center gap-3 text-center group hover:border-ember/60 transition-all duration-300"
        >
          <div class="w-12 h-12 border border-ember/30 flex items-center justify-center group-hover:bg-ember/10 transition-colors duration-300">
            <svg class="w-5 h-5 text-ember" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
            </svg>
          </div>
          <div>
            <div class="font-oswald text-ember tracking-widest uppercase text-sm mb-1">LINE</div>
            <div class="text-washi text-sm font-open-sans">@sawapattaya</div>
          </div>
        </a>
      </div>

      <!-- Map full-width -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="h-px w-8 bg-ember"></div>
          <span class="font-open-sans text-ember text-xs tracking-[0.3em] uppercase">Find Us</span>
        </div>
        <h2 class="section-heading text-3xl text-washi mb-6">
          Tree Town, <span class="text-ember">Pattaya</span>
        </h2>

        <!-- Google Maps Embed — full width, taller -->
        <div class="relative w-full h-[450px] bg-charcoal card-ink overflow-hidden mb-6">
          <iframe
            title="Yakiniku SAWA Pattaya location map"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3906.9258!2d100.8825!3d12.9236!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTLCsDU1JzI1LjAiTiAxMDDCsDUyJzU3LjAiRQ!5e0!3m2!1sen!2sth!4v1699999999999!5m2!1sen!2sth"
            class="w-full h-full border-0 grayscale contrast-125 opacity-90"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>

        <!-- Getting There -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="card-ink p-5 flex items-start gap-3">
            <span class="text-ember text-xl shrink-0 mt-0.5">🚕</span>
            <div>
              <strong class="font-oswald text-washi text-sm tracking-wider uppercase block mb-1">By Taxi / Grab</strong>
              <p class="text-washi/60 text-xs leading-relaxed">Show driver: ร้านยากินิกุซาวะ พัทยา หรือ Tree Town พัทยา ซอย 9</p>
            </div>
          </div>
          <div class="card-ink p-5 flex items-start gap-3">
            <span class="text-ember text-xl shrink-0 mt-0.5">🚗</span>
            <div>
              <strong class="font-oswald text-washi text-sm tracking-wider uppercase block mb-1">By Car</strong>
              <p class="text-washi/60 text-xs leading-relaxed">Inside Tree Town complex, Pattaya 9 Alley. Parking available on site.</p>
            </div>
          </div>
          <div class="card-ink p-5 flex items-start gap-3">
            <span class="text-ember text-xl shrink-0 mt-0.5">📍</span>
            <div>
              <strong class="font-oswald text-washi text-sm tracking-wider uppercase block mb-1">GPS</strong>
              <p class="text-washi/60 text-xs leading-relaxed mb-2">12.9236° N, 100.8825° E</p>
              <a
                href="https://maps.google.com/?q=Tree+Town+Pattaya+Yakiniku+SAWA"
                target="_blank"
                rel="noopener noreferrer"
                class="text-ember text-xs font-oswald tracking-widest uppercase hover:text-ember-dark transition-colors"
              >Open in Maps →</a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       EMAIL CONTACT
  ══════════════════════════════════════════════════ -->
  <section class="py-16 px-4 sm:px-6 bg-charcoal" aria-labelledby="email-heading">
    <div class="max-w-3xl mx-auto text-center">
      <h2 id="email-heading" class="section-heading text-3xl text-washi mb-4">
        Have a <span class="text-ember">Question?</span>
      </h2>
      <div class="ember-divider"></div>
      <p class="text-washi/60 mb-8 leading-relaxed">
        For corporate bookings, private events, or general enquiries, reach out to us via email and we'll respond within 24 hours.
      </p>
      <a
        href="mailto:contact@all-pattaya.com"
        class="btn-outline inline-flex items-center gap-2"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        contact@all-pattaya.com
      </a>
    </div>
  </section>
</Layout>
