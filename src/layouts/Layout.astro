---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileFooter from '../components/MobileFooter.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  schema?: object;
  breadcrumbs?: Array<{ name: string; url: string }>;
  page?: string;
}

const {
  title,
  description = 'Yakiniku SAWA Pattaya — Premium Japanese Wagyu BBQ restaurant in Pattaya. Experience authentic A5-rank Wagyu Yakiniku in an elegant smoke-managed environment. Book your table today.',
  ogImage = '/images/og-default.jpg',
  canonical,
  schema,
  breadcrumbs,
  page = '',
} = Astro.props;

const siteUrl = 'https://yakiniku-sawa-pattaya.com';
const canonicalUrl = canonical ?? `${siteUrl}${Astro.url.pathname}`;

const restaurantSchema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: 'Yakiniku SAWA Pattaya',
  description: 'Premium Japanese Wagyu Yakiniku restaurant in Pattaya, Thailand. Specializing in A5-rank Wagyu beef with a sophisticated smoke-managed environment.',
  url: siteUrl,
  telephone: '+6633640787',
  email: 'contact@all-pattaya.com',
  servesCuisine: 'Japanese Yakiniku',
  priceRange: '$$',
  currenciesAccepted: 'THB',
  paymentAccepted: 'Cash, Credit Card',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '502/54(b34) Tree Town, Pattaya 9 Alley',
    addressLocality: 'Pattaya',
    addressRegion: 'Chonburi',
    postalCode: '20150',
    addressCountry: 'TH',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 12.9236,
    longitude: 100.8825,
  },
  menu: `${siteUrl}/menu`,
  hasMenu: {
    '@type': 'Menu',
    name: 'SAWA Yakiniku Menu',
    url: `${siteUrl}/menu`,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '17:00',
      closes: '23:00',
    },
  ],
  sameAs: [],
};

const breadcrumbSchema = breadcrumbs
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: siteUrl,
        },
        ...breadcrumbs.map((bc, index) => ({
          '@type': 'ListItem',
          position: index + 2,
          name: bc.name,
          item: `${siteUrl}${bc.url}`,
        })),
      ],
    }
  : null;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Wagyu Pattaya, Japanese BBQ Pattaya, Yakiniku Pattaya, A5 Wagyu Thailand, best Japanese restaurant Pattaya, SAWA Pattaya, premium beef Pattaya" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Yakiniku SAWA Pattaya" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="restaurant" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Yakiniku SAWA Pattaya" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Preconnect for Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600;700&family=Open+Sans:ital,wght@0,300;0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />

    <!-- Schema.org Restaurant JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(restaurantSchema)} />

    <!-- Page-specific Schema -->
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <!-- Breadcrumb Schema -->
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}

    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-KGDM6T65');</script>
    <!-- End Google Tag Manager -->
  </head>
  <body class="min-h-screen bg-charcoal overflow-x-hidden">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KGDM6T65"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Header page={page} />

    <main>
      <slot />
    </main>

    <Footer />
    <MobileFooter />
  </body>
</html>
